# Required: your DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Optional: model override. Defaults to deepseek-chat.
# DEEPSEEK_MODEL=deepseek-chat

# Optional: where the SQLite database lives. Defaults to data/app.db.
# DATABASE_PATH=/var/lib/english-for-ai-building/app.db

# Set to 1 once the site is served over https (marks the login cookie Secure).
# COOKIE_SECURE=1
